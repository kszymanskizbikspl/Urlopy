# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.

# Adres serwera w sieci LAN (trafia do linków w e-mailach), np. http://192.168.88.X:1003
APP_URL=http://192.168.88.X:1003

# Pierwszy administrator — przy pierwszym starcie serwer wypisze w logach link z zaproszeniem
ADMIN_EMAIL=

# Losowe sekrety, np.: openssl rand -hex 32
SESSION_SECRET=
# Klucz do szyfrowania hasła SMTP w bazie (min. 32 znaki, np. openssl rand -hex 32).
# Bez niego aplikacja działa, ale w Ustawieniach nie da się zapisać hasła SMTP.
# Nie zmieniać po skonfigurowaniu poczty (inaczej trzeba ponownie wpisać hasło SMTP).
SETTINGS_KEY=

# Tylko przy wystawieniu przez reverse proxy (np. Pangolin) — dokładny adres proxy, od którego
# przyjmować X-Forwarded-For/-Proto. W samym LAN zostaw puste (PLAN.md, sekcja 8a).
# TRUST_PROXY=

# Port wewnątrz kontenera — zostaw 3000 (docker-compose mapuje 1003:3000)
# PORT=3000
