# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.

# Adres, pod którym aplikacja jest widoczna (linki w e-mailach)
APP_URL=https://urlopy.zbiks.pl

# Pierwszy administrator — przy pierwszym starcie serwer wypisze w logach link z zaproszeniem
ADMIN_EMAIL=

# Losowe sekrety, np.: openssl rand -hex 32
SESSION_SECRET=
# Klucz do szyfrowania hasła SMTP w bazie (32 bajty hex) — nie zmieniać po skonfigurowaniu poczty
SETTINGS_KEY=
